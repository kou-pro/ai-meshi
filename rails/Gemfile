source "https://rubygems.org"
git_source(:github) {|repo| "https://github.com/#{repo}.git" }

ruby "3.2.10"

# device_token_authを導入する
gem "devise"
gem "devise_token_auth"

# Google OAuth2 認証（本番でも必要）
gem "omniauth-google-oauth2"
gem "omniauth-rails_csrf_protection"

# railsの起動時間を短縮する（標準gem）
gem "bootsnap", require: false

# MySQLに接続する
gem "mysql2", "~> 0.5"

# pumaサーバーを使えるようにする（標準gem）
gem "puma", "~> 6.0"

# rails本体（標準gem）
gem "rails", "~> 7.2.3"

# タイムゾーン情報を提供する（標準gem）
gem "tzinfo-data", platforms: %i[mingw mswin x64_mingw jruby]

# coreの導入
gem "rack-cors"

# S3への画像アップロードに使用する
gem "aws-sdk-s3", require: false

# pageネーションに利用
gem "kaminari"

# 日本語化
gem "rails-i18n"

# OpenAI API（レシピ生成機能、本番でも必要）
gem "ruby-openai"

group :test do
  gem "factory_bot_rails"
  # テストフレームワーク rspec を導入する
  gem "rspec-rails"

  # validation / association / callback 等の RSpec マッチャーを 1 行で書ける
  gem "shoulda-matchers", "~> 7.0"

  # 外部 API (OpenAI 等) のモック用
  gem "webmock", "~> 3.26"
end

group :development, :test do
  # ダミーデータを生成する (テスト用 + 開発時の seed 用)
  gem "faker", "~> 3.8"

  # pry コンソールを使えるようにする。
  gem "pry-byebug"
  gem "pry-doc"
  gem "pry-rails"

  # rubocop を使えるようにする。
  gem "rubocop-faker"
  gem "rubocop-rails"
  gem "rubocop-rspec"

  # 環境毎の設定管理を行う
  gem "config"

  # mail認証のためのletter_poenerを追加
  gem "letter_opener_web"
end

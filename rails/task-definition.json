{
  "containerDefinitions": [
    {
      "name": "rails",
      "image": "077369590690.dkr.ecr.ap-northeast-1.amazonaws.com/ai-meshi-rails:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp",
          "name": "rails-3000-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "RAILS_LOG_TO_STDOUT",
          "value": "true"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-1"
        },
        {
          "name": "RAILS_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "AWS_BUCKET",
          "value": "ai-meshi-bucket"
        },
        {
          "name": "FRONT_DOMAIN",
          "value": "https://aimeshi.com"
        },
        {
          "name": "RAILS_PUBLIC_URL",
          "value": "https://api.aimeshi.com"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-meshi-task-definition-backend",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/api/v1/health_check || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": [],
      "secrets": [
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:077369590690:secret:ai-meshi-rails-secrets-152MIi:GOOGLE_CLIENT_SECRET::"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:077369590690:secret:ai-meshi-rails-secrets-152MIi:GOOGLE_CLIENT_ID::"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:077369590690:secret:ai-meshi-rails-secrets-152MIi:DATABASE_URL::"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:077369590690:secret:ai-meshi-rails-secrets-152MIi:OPENAI_API_KEY::"
        },
        {
          "name": "RAILS_MASTER_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:077369590690:secret:ai-meshi-rails-secrets-152MIi:RAILS_MASTER_KEY::"
        }
      ]
    }
  ],
  "family": "ai-meshi-task-definition-backend",
  "taskRoleArn": "arn:aws:iam::077369590690:role/ai-meshi-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::077369590690:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "enableFaultInjection": false
}
